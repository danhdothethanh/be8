@model MaSV_MyStore.Models.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="card shadow mx-auto" style="max-width:720px;">
        <div class="card-body text-center py-5">
            <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
            <h2 class="text-success mt-3">Đặt hàng thành công!</h2>
            <p class="lead text-muted">Cảm ơn bạn đã mua hàng tại MyStore.</p>

            <hr class="my-4" />

            <div class="text-start px-3">
                <div class="row mb-2">
                    <div class="col-5 text-muted">Mã đơn hàng:</div>
                    <div class="col-7"><strong>#@Model.OrderID</strong></div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Ngày đặt:</div>
                    <div class="col-7">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Tổng tiền:</div>
                    <div class="col-7"><strong class="text-danger">@Model.TotalAmount.ToString("N0") ₫</strong></div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Thanh toán:</div>
                    <div class="col-7">@Model.PaymentMethod (@Model.PaymentStatus)</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Giao hàng:</div>
                    <div class="col-7">@Model.DeliveryMethod</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Địa chỉ giao:</div>
                    <div class="col-7">@Model.ShippingAddress</div>
                </div>
                <div class="row mb-2">
                    <div class="col-5 text-muted">Trạng thái:</div>
                    <div class="col-7"><span class="badge bg-warning text-dark">@Model.Status</span></div>
                </div>
            </div>

            <h5 class="mt-4 mb-3">Chi tiết đơn hàng</h5>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderDetails)
                    {
                        <tr>
                            <td>@(d.Product != null ? d.Product.ProductName : "Sản phẩm #" + d.ProductID)</td>
                            <td class="text-center">@d.Quantity</td>
                            <td class="text-end">@d.UnitPrice.ToString("N0")</td>
                            <td class="text-end">@((d.Quantity * d.UnitPrice).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-4">
                <a href="@Url.Action("MyOrder", "Order")" class="btn btn-primary me-2">
                    <i class="fas fa-history"></i> Xem lịch sử đơn hàng
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
