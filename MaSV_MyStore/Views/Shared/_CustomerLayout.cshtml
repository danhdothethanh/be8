<!DOCTYPE html>
<html lang="vi">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MyStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        .navbar-brand { font-weight: bold; font-size: 1.5rem; }
        .cart-badge { position: relative; top: -8px; left: -5px; }
        footer { background: #343a40; color: white; padding: 20px 0; margin-top: 50px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="fas fa-store"></i> MyStore
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @Html.Partial("_CategoriesPV")

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user"></i>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <span>Hello, @User.Identity.Name</span>
                            }
                            else
                            {
                                <span>Tài khoản</span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li><a class="dropdown-item" href="@Url.Action("ProfileInfo", "Account")"><i class="fas fa-user-edit"></i> Thông tin tài khoản</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("MyOrder", "Order")"><i class="fas fa-history"></i> Lịch sử mua hàng</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" href="@Url.Action("Register", "Account")"><i class="fas fa-user-plus"></i> Đăng ký</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Login", "Account")"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a></li>
                            }
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Cart")">
                            <i class="fas fa-shopping-cart"></i> Giỏ hàng
                            @{
                                var cartCount = Session["CartCount"] as int? ?? 0;
                            }
                            @if (cartCount > 0)
                            {
                                <span class="badge bg-danger cart-badge">@cartCount</span>
                            }
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="text-center">
        <div class="container">
            <p class="mb-1">&copy; @DateTime.Now.Year - MyStore | Đồ án ASP.NET MVC5 Entity Framework</p>
            <p class="mb-0 small">ThS. Bùi Thị Thanh Tú | Sinh viên thực hiện</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
